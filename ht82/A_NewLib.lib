#encoding utf-8
#
# HT82V739
#
DEF HT82V739 U 0 5 Y Y 1 F N
F0 "U" 50 300 50 H V L CNN
F1 "HT82V739" 50 200 50 H V L CNN
F2 "" 100 100 50 H I C CNN
F3 "" 200 200 50 H I C CNN
$FPLIST
 SOIC*3.9x4.9mm*P1.27mm*
 DIP*W7.62mm*
 MSSOP*P0.65mm*
 TSSOP*3x3mm*P0.5mm*
$ENDFPLIST
DRAW
P 4 0 1 10 200 0 -200 200 -200 -200 200 0 f
X OUTN 1 100 -300 250 U 50 20 1 1 I
X AUDIN 2 -300 0 100 R 50 20 1 1 I
